---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    {% if page.related_papers %}
      <div class="project-publication-links d-flex flex-wrap gap-2">
        {% for paper in page.related_papers %}
          {% capture publication_url %}/publications/#{{ paper.key }}{% endcapture %}
          <a class="btn btn-outline-primary btn-sm" href="{{ publication_url | relative_url }}">
            <i class="fa-solid fa-book-open"></i>
            {{ paper.label | default: 'Related publication' }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
